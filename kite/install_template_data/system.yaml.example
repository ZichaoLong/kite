# KITE instance config template.
# Copy to ~/.config/kite/system.yaml (or $KITE_CONFIG_DIR/system.yaml) and fill
# in real values. The real file must stay out of version control (mode 0600).

# Feishu self-built app credentials (https://open.feishu.cn/app → 凭证与基础信息):
app_id: "cli_xxx"
app_secret: "xxx"

# Admins (open_ids). The first admin can also register at runtime via the
# Feishu `/init <token>` command (the token is generated by kited on first
# start; `kitectl config init-token` shows it and where it lives).
# admin_open_ids: []

# Working directory for sessions auto-created on first use.
# default_working_dir: "~"

# Approval timeout in seconds; on timeout KITE responds REJECTED (never
# auto-approves). Default: 300.
# approval_timeout_seconds: 300

# Inbound image attachments (docs/contracts/images.md): how long a staged
# image stays pending consumption, and the post-download byte cap per image
# (also the cap for `kitectl image send`). Defaults: 600 / 20971520 (20 MB).
# attachment_ttl_seconds: 600
# attachment_max_bytes: 20971520

# Assistant-mode group context (docs/contracts/group-chat.md): the Feishu
# REST history backfill merged into the per-chat log is capped at this many
# messages over this lookback window. 0 disables the backfill (context is
# then local-log only). Defaults: 50 / 86400 (24h).
# group_history_fetch_limit: 50
# group_history_fetch_lookback_seconds: 86400

# kap-server connection (all optional; defaults shown):
# kap:
#   host: 127.0.0.1   # loopback only — validated at startup: the managed
#                     # child binds loopback (no TLS), other values are rejected
#   port: 58627       # requested port; the server may bump +1 on conflict
#   home: ~/.kimi-code  # KIMI_CODE_HOME for the managed child
#   kimi_bin: kimi    # path to the kimi binary
